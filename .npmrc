; Make the declared Node requirement enforced rather than advisory.
;
; Without this, npm prints "EBADENGINE" and installs anyway, so a machine on a
; Node older than the floor builds a tree that may not run and finds out later,
; somewhere less obvious than install time. With it, `npm ci` stops and names
; the version and the range.
;
; This is deliberately not `--omit` or a resolution override: it changes no
; dependency, only whether the declared contract is checked.
engine-strict=true
