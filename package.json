{
  "name": "orbit-community",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "predev": "node scripts/check-dependencies.mjs",
    "dev": "next dev apps/web --webpack --hostname 0.0.0.0 --port 3000",
    "dev:bot": "tsx watch apps/bot/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "build": "npm run build:web && npm run build:services",
    "prebuild": "node scripts/check-dependencies.mjs",
    "prebuild:web": "node scripts/check-dependencies.mjs",
    "build:web": "next build apps/web --webpack",
    "build:services": "tsup",
    "prestart": "node scripts/check-dependencies.mjs",
    "start": "next start apps/web --hostname 0.0.0.0 --port 3000",
    "start:bot": "node dist/bot.js",
    "start:worker": "node dist/worker.js",
    "commands:register": "tsx apps/bot/src/commands/register.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen apps/web && tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint apps packages tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "test:ci": "npm test && npm run test:e2e",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mjs,css,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"docs/**/*.md\" README.md",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,css,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\"",
    "channels:export": "tsx apps/bot/src/tools/export-channels.ts",
    "roles:export": "tsx apps/bot/src/tools/export-channels.ts --roles-only",
    "music:doctor": "tsx apps/bot/src/tools/music-doctor.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "bullmq": "^5.63.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.3.0",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.2",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "shoukaku": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.18",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
