# DEMO: no live credentials, database, Redis, audio, or Discord messages required.
# npm run dev also defaults to demo ONLY in development when no Discord client ID exists.
# Production NEVER implicitly falls back to demo. Set this explicitly.
DEMO_MODE=true
# Optional absolute path for the single-process demo JSON store (default .data/demo.json).
# DEMO_DATA_PATH=/absolute/path/to/orbit/.data/demo.json

# LIVE: set DEMO_MODE=false. Runtime contracts: packages/core/src/environment.ts.
# web: DB + Redis + bot token + OAuth client/secret + APP_URL/APP_SECRET.
# bot: DB + Redis + bot token/client ID; worker: DB + Redis + bot token.
# register: token/client ID (+ optional guild); exports: token only;
# migrate: database only; music doctor: Lavalink only. --help needs no credentials.
# Live validation runs at service/tool entry, not during module import/build.
# Optional music settings are paired only by the bot/doctor that consume them.
APP_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Also used by the read-only channels:export and roles:export CLIs (no database/Redis needed).
DISCORD_TOKEN=
# Optional: register commands in one development server instead of globally.
DISCORD_GUILD_ID=
# Optional bot presence, applied once after the gateway is ready (no rotation,
# no member/server counts). Default: watching "/help". Leave BOT_ACTIVITY empty
# to keep the plain bot name; BOT_ACTIVITY_TYPE is playing|watching|listening|
# competing and BOT_STATUS is online|idle|dnd|invisible. Unknown values fall back
# to watching/online with a startup warning.
# BOT_ACTIVITY=/help
# BOT_ACTIVITY_TYPE=watching
# BOT_STATUS=online

# Local host connections; Compose overrides the hostname inside containers.
# For a fresh database. Existing database passwords must be rotated with SQL.
# Keep the password in DATABASE_URL in sync when running services on the host.
POSTGRES_PASSWORD=orbit_dev_password
DATABASE_URL=postgres://orbit:orbit_dev_password@localhost:5432/orbit
REDIS_URL=redis://localhost:6379

# IsThereAnyDeal key: https://isthereanydeal.com/apps/
# Required server-side on bot, web AND worker. Header auth; never NEXT_PUBLIC_*.
# Setup/register /deals feed and configure popularity/ratings: docs/DEALS.md
# Do not put API keys into source URLs or any NEXT_PUBLIC_* variable.
ITAD_API_KEY=

# Optional Lavalink v4. Leave BOTH blank to disable music connections.
# To enable: set LAVALINK_URL=localhost:2333 and choose a strong password,
# then run: docker compose --profile music up -d lavalink
# Host port 2333 is published on loopback only. Compose bots use lavalink:2333.
# URL has no protocol prefix; set SECURE=true when using a TLS endpoint.
LAVALINK_URL=
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Read-only source diagnostics: npm run music:doctor -- --query "your failing query"
# Only configured, supported sources. Playback availability is not guaranteed.
MUSIC_SEARCH_PREFIX=scsearch
# Supported prefixes: scsearch, bcsearch, ytsearch, ytmsearch (one default, no fallback).
# The host list can restrict approved adapters, not enable arbitrary/adult sources.
MUSIC_ALLOWED_HOSTS=soundcloud.com,bandcamp.com,youtube.com,youtu.be,ocremix.org
# SponsorBlock is applied per player when the plugin is present. Empty disables it.
# This skips marked sponsor segments; it is NOT an explicit-content/SFW filter.
MUSIC_SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction

# Steam news cards: when an article carries no image, use the game's store
# header/capsule artwork, labelled as app artwork (never as article imagery).
# One cached lookup per app id; set to false to keep those cards text-only.
# STEAM_APP_ARTWORK=true

LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
# CI only: a dedicated, disposable PostgreSQL test database.
# TEST_DATABASE_URL=postgres://orbit:orbit_dev_password@localhost:5432/orbit_test
