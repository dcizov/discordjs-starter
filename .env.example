# Required Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=
# Required Discord application/client ID.
DISCORD_CLIENT_ID=
# Postgres connection string. The compose service uses these credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bot
# Optional: deploy the commands to one server instead of globally.
# Guild commands register instantly; global ones can take up to an hour to appear.
DISCORD_GUILD_ID=
