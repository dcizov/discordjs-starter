{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@orbit/core": ["packages/core/src/index.ts"],
      "@orbit/db": ["packages/db/src/index.ts"],
      "@orbit/core/*": ["packages/core/src/*.ts"],
      "@/*": ["apps/web/*"]
    }
  },
  "include": [
    "apps/bot/**/*.ts",
    "apps/worker/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
